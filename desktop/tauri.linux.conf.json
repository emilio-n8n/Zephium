{
  "productName": "app.zephium",
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zephium",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "linux": {
      "deb": {
        "desktopTemplate": "linux/zephium.desktop.hbs",
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0 (>= 2.54.0)"
        ]
      },
      "rpm": {
        "desktopTemplate": "linux/zephium.desktop.hbs"
      }
    }
  }
}
